rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Default-Deny Catch-All
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidTransaction(data, userId) {
      return data.id is string && data.id.size() <= 128
        && data.userId == userId
        && (data.type == 'income' || data.type == 'expense')
        && data.amount is number && data.amount >= 0
        && data.category is string && data.category.size() <= 64
        && data.date is string && data.date.size() == 10
        && (!('note' in data) || (data.note is string && data.note.size() <= 500));
    }

    function isValidUserProfile(data, userId) {
      return data.uid == userId
        && data.email is string && data.email.size() <= 256
        && (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 128))
        && (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 1024));
    }

    // User profile collection
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId) && isValidUserProfile(incoming(), userId);
      allow update: if isOwner(userId) && isValidUserProfile(incoming(), userId);
      allow delete: if isOwner(userId);

      // User transactions subcollection
      match /transactions/{transactionId} {
        allow get: if isOwner(userId);
        allow list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidTransaction(incoming(), userId);
        allow update: if isOwner(userId) && isValidTransaction(incoming(), userId);
        allow delete: if isOwner(userId);
      }
    }
  }
}
