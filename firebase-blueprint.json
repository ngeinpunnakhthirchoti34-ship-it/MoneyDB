{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile information authenticated via Google/Gmail",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Firebase Auth UID of the user",
          "maxLength": 128
        },
        "email": {
          "type": "string",
          "description": "User's email address",
          "maxLength": 256
        },
        "displayName": {
          "type": "string",
          "description": "User display name",
          "maxLength": 128
        },
        "photoURL": {
          "type": "string",
          "description": "User avatar URL",
          "maxLength": 1024
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "ISO timestamp of account registration"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "ISO timestamp of last update"
        }
      },
      "required": ["uid", "email"]
    },
    "Transaction": {
      "title": "Transaction",
      "description": "Income or expense record created by the user",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique transaction ID",
          "maxLength": 128
        },
        "userId": {
          "type": "string",
          "description": "ID of user who owns this transaction",
          "maxLength": 128
        },
        "type": {
          "type": "string",
          "description": "Type of transaction: income or expense",
          "enum": ["income", "expense"]
        },
        "amount": {
          "type": "number",
          "description": "Amount in THB"
        },
        "category": {
          "type": "string",
          "description": "Category name (e.g., อาหาร, เงินเดือน)",
          "maxLength": 64
        },
        "date": {
          "type": "string",
          "description": "Date of transaction in YYYY-MM-DD format",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "note": {
          "type": "string",
          "description": "Optional memo or description",
          "maxLength": 500
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "ISO timestamp when created"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "ISO timestamp when updated"
        }
      },
      "required": ["id", "userId", "type", "amount", "category", "date"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "Stores user profile settings and preferences"
    },
    "/users/{userId}/transactions/{transactionId}": {
      "schema": "Transaction",
      "description": "Subcollection of all income and expense records belonging to a user"
    }
  }
}
